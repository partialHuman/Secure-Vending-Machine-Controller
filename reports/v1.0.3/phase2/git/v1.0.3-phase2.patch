+
+        //------------------------------------------------------------
+        // SECTION 8: Multi-Configuration Array Depth & Guard Tests
+        //------------------------------------------------------------
+        // DUT_1 (PRODUCT_COUNT = 1)
+        check_condition("DUT_1: array size is 1", $size(dut_1.qty_mem) == 1);
