+        c4_id = 5'd4; #1;
+        check_condition("DUT_4: read invalid ID 4 returns price 0", c4_price == 16'd0);
+        c4_read_en = 1'b0;
+
+        // DUT_8 (PRODUCT_COUNT = 8)
+        check_condition("DUT_8: array size is 8", $size(dut_8.qty_mem) == 8);
